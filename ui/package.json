{
  "name": "@wavecode/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "prebuild": "bash ../bin/check-llm-key.sh",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:no-console": "eslint src/domain src/application --ext .ts --no-warn-ignored",
    "validate:presets": "node --experimental-strip-types --no-warnings ../scripts/validate-presets.ts",
    "test:precommit": "npm run typecheck && npx vitest run && npm run lint:no-console && npm run validate:presets",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@strudel/core": "^1.2.6",
    "@strudel/webaudio": "^1.3.0",
    "@strudel/mini": "^1.2.6",
    "@strudel/tonal": "^1.2.6",
    "@strudel/transpiler": "^1.2.6",
    "@strudel/serial": "^1.0.0",

    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.43.14",
    "@codemirror/language": "^6.13.1",
    "@codemirror/commands": "^6.7.1",
    "@codemirror/search": "^6.5.6",
    "@codemirror/autocomplete": "^6.18.1",
    "@codemirror/lint": "^6.8.4",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@lezer/highlight": "^1.2.5",
    "@lezer/common": "^1.5.3",
    "codemirror": "^6.0.1",

    "effect": "^3.22.0",
    "@effect/schema": "^0.75.0",
    "@effect/platform": "^0.97.0",
    "@effect/platform-browser": "^0.77.0",
    "@effect/typeclass": "^0.41.0",

    "zod": "^3.23.8",

    "solid-js": "^1.9.17",
    "nanoid": "^5.0.7",
    "clsx": "^2.1.1",
    "idb-keyval": "^6.2.1",
    "@tonejs/midi": "^2.0.28",
    "lz-string": "^1.5.0"
  },
  "devDependencies": {
    "vite-plugin-solid": "^2.10.0",
    "vite": "^5.4.10",
    "typescript": "^5.6.3",
    "vitest": "^2.1.0",
    "@solidjs/testing-library": "^0.8.0",
    "@playwright/test": "^1.48.0",
    "jsdom": "^25.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.13.0",
    "@eslint/js": "^9.13.0",
    "typescript-eslint": "^8.11.0",
    "eslint-plugin-solid": "^0.14.0",
    "vite-plugin-pwa": "^0.20.5"
  }
}
