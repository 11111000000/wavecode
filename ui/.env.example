# wavecode build-time env.
#
# Copy to .env.local and fill in. .env.local is in .gitignore.
#
# Vite инжектит VITE_* в client bundle при сборке. Per-app LiteLLM-ключ
# публичный в bundle (это нормально: ключ scoped, revocable).

# URL LiteLLM proxy (default для tailnet+public, override для dev).
# Tailnet:   http://127.0.0.1:11435/v1  (no auth, no CORS нужны для localhost)
# Public:    https://llm.kosov.online/v1  (CORS explicit allowlist на angara-1)
VITE_LLM_PROXY_URL=https://llm.kosov.online/v1

# Per-app LiteLLM-ключ (scoped к [smart, fast]).
#
# /key/generate endpoint сейчас возвращает 500 (PostgreSQL не настроен в llm-proxy),
# поэтому используем MASTER_KEY напрямую. Это работает, но в bundle попадает
# самый мощный ключ — revoke нельзя.
#
# Production deployment: починить /key/generate endpoint в llm-proxy.nix или
# сделать отдельный ключ с минимальными scopes вручную.
#
# Где взять значение:
#   На angara-1:  sudo grep ^LITELLM_MASTER_KEY /etc/secrets/llm-proxy/master.key
#   Скопируй ВСЁ после "=" включая префикс "sk-litellm-".
#
# ⚠️  КРИТИЧНО: значение должно СОВПАДАТЬ с LITELLM_MASTER_KEY на angara-1.
# Если не совпадает — public instance (11436) вернёт 400 'No connected db'
# (LiteLLM checks api_key != master_key, ищет virtual key в Prisma DB, DB нет
# → 400). Bundle соберётся и задеплоится, но UI покажет "LLM ошибка" для
# каждого запроса. bin/check-llm-key.sh (запускается перед pnpm build)
# ловит эту ситуацию автоматически.
#
# Проверить что ключ работает:
#   curl -X POST https://llm.kosov.online/v1/chat/completions \
#     -H "Authorization: Bearer $VITE_LLM_PROXY_KEY" \
#     -H 'Content-Type: application/json' \
#     -d '{"model":"fast","messages":[{"role":"user","content":"PONG"}],"max_tokens":5}'
VITE_LLM_PROXY_KEY=sk-litellm-REPLACE-ME

# ── распознавание речи ────────────────────────────────────────────────
# Какой STT-движок использовать. Не задано = server.
#
#   server  (по умолчанию) — наш whisper на angara-1. Работает в любом
#                          браузере, аудио не уходит наружу, есть
#                          живой индикатор уровня. Измерено 2.6-5.2 с.
#   auto                  — Web Speech, если браузер его умеет, с
#                          откатом на сервер. ВНИМАНИЕ: в Chrome
#                          Web Speech-объект есть, но распознавателя за
#                          ним нет — он молчит, и FallbackSTT тратит
#                          WATCHDOG_MS (2.5 с) впустую на каждом
#                          нажатии. Итого ~8 с тишины до первого
#                          слова и отправка голоса в Google.
#   web                   — только Web Speech. Для отладки: увидеть
#                          настоящую ошибку облака, не спрятанную за
#                          fallback'ом.
#
# Значение, отличное от этих трёх, трактуется как server (опечатка в
# env не должна выключать голос целиком).
VITE_STT_BACKEND=server